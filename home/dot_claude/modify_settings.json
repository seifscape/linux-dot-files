{{- /* chezmoi:modify-template */ -}}
{{- /*
  settings.json belongs to Claude Code: it rewrites the file for permissions,
  plugins and MCP servers. Merge in only the keys below and keep everything else:
  - statusLine renders the claude-code profile from the shared starship.toml.
  - env.DISABLE_AUTOUPDATER: mise installs and updates claude here (Homebrew does
    on the Mac). Without it, Claude Code's own updater can reinstall itself under
    ~/.local/share/claude and ~/.local/bin/claude, leaving two copies.
*/ -}}
{{- $settings := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $statusLine := dict "type" "command" "command" "starship statusline claude-code" "padding" 0 -}}
{{- $settings = setValueAtPath "statusLine" $statusLine $settings -}}
{{- $settings = setValueAtPath "env.DISABLE_AUTOUPDATER" "1" $settings -}}
{{- $settings | toPrettyJson -}}
