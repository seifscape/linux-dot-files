{{- /* chezmoi:modify-template */ -}}
{{- /*
  settings.json belongs to Claude Code: it rewrites the file for permissions,
  plugins and MCP servers. Merge in only the statusLine key, which renders the
  claude-code profile from the shared starship.toml, and keep everything else.
*/ -}}
{{- $settings := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $statusLine := dict "type" "command" "command" "starship statusline claude-code" "padding" 0 -}}
{{- setValueAtPath "statusLine" $statusLine $settings | toPrettyJson -}}
