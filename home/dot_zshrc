autoload -Uz compinit && compinit
# Initialisation
# mise goes first: it provides sheldon, zoxide, atuin and starship here.
eval "$(mise activate zsh)"
eval "$(sheldon source)"
eval "$(zoxide init zsh)"
# fnox and aube are dev-role tools in mise; skip them where they aren't installed.
(( $+commands[fnox] )) && eval "$(fnox activate zsh)"
(( $+commands[aube] )) && eval "$(aube activate zsh)"
eval "$(atuin init zsh)"
eval "$(starship init zsh)"

# Source custom configs (pulled from macos-dot-files)
[ -f ~/.exports ] && source ~/.exports
[ -f ~/.aliases ] && source ~/.aliases
[ -f ~/.functions ] && source ~/.functions
[ -f ~/.zsh_bindings ] && source ~/.zsh_bindings

# Machine-specific aliases and checks, never committed (e.g. the Pi's docker aliases)
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# Dev tool update checks (mise)
~/.config/scripts/dev-updates.sh

fastfetch

# print extra white line
echo
