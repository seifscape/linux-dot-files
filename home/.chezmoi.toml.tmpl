{{- /* Asked once on `chezmoi init`; answers stay in ~/.config/chezmoi, never in git. */ -}}
{{- $name := promptStringOnce . "name" "Git name" -}}
{{- $email := promptStringOnce . "email" "Git email" -}}

[data]
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  # Branch of macos-dot-files the shared configs come from. Point it at a
  # feature branch to try changes before merging them on the Mac side.
  macosRef = "main"
