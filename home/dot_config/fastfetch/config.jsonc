// Raspberry Pi OS (trixie) reports itself as plain Debian in /etc/os-release, so
// fastfetch would show the Debian swirl. Force the Raspberry Pi logo instead.
// Only written on a Pi; see .chezmoiignore.
//
// A config file with no "modules" key shows the logo and nothing else, so the
// list below is fastfetch's own default (from `fastfetch --gen-config`, 2.69).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "raspbian"
  },
  "modules": [
    "title", "separator",
    "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "wmtheme", "theme", "icons", "font", "cursor",
    "terminal", "terminalfont",
    "cpu", "gpu", "memory", "swap", "disk", "localip",
    "battery", "poweradapter", "locale",
    "break", "colors"
  ]
}
