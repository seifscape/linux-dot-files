# Linux-only Ghostty settings, from linux-dot-files. Ghostty loads this file
# next to the shared `config` that chezmoi pulls from the Mac. These keys give
# Super (Meta) the Mac's Cmd shortcuts; macOS already has them by default.

# Like Cmd+K on the Mac: clear the screen and scrollback
keybind = super+k=clear_screen

# Like Cmd+T on the Mac: new tab
keybind = super+t=new_tab

# Darker base than the Frappe theme's #303446 (Frappe "crust"). Blur is done by
# Hyprland here, so the Mac's glass look reads lighter/more transparent without it.
background = #232634
